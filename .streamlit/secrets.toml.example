# ============================================================
#  NetGuard AI — Streamlit Secrets Template
#  For Streamlit Community Cloud: Settings -> Secrets
#  Copy these keys and fill in real values.
#  Your local .streamlit/secrets.toml is git-ignored.
# ============================================================

# Backend API base URL (Hugging Face Space or local):
# API_BASE_URL = "https://<your-user>-netguard-backend.hf.space"

# LLM keys (only if the Streamlit app itself calls an LLM):
# GEMINI_API_KEY = "your_gemini_key_here"
# OPENAI_API_KEY = "your_openai_key_here"

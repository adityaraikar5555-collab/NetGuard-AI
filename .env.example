# ============================================================
#  NetGuard AI — Environment Template
#  Copy this file to `.env` and fill in your API keys.
#  NEVER commit your real .env (it is git-ignored).
#  For cloud deployment, set these as Secrets on the platform
#  (Hugging Face "Variables and secrets" / Streamlit Secrets).
# ============================================================

# --- LLM Provider -------------------------------------------------
# Options: auto | gemini | openai | groq | ollama | offline_soc
LLM_PROVIDER=auto

# Gemini (free tier available)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local — rarely used in cloud)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- LLM Behaviour --------------------------------------------------
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700

# --- RAG Embeddings --------------------------------------------------
# Options: auto | tfidf | sentence_transformers | gemini | openai
RAG_EMBEDDING_PROVIDER=tfidf
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSION=1024

# --- RAG Retrieval ---------------------------------------------------
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.26
RAG_MAX_CONTEXT_LENGTH=3000
